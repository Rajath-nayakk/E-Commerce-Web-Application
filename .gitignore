# ==============================================================================
# NovaTech Gear - Git Ignore Rules
# ==============================================================================

# Environment files & Secrets
.env
.env.local
.env.*.local

# Database local storage & SQLite database files
database/*.sqlite
database/*.sqlite-journal
*.sqlite
*.sqlite3
*.db

# Dynamic uploaded files (preserve seed product illustrations and photos)
/public/uploads/*
!/public/uploads/products/
!/public/uploads/products/product-[0-9]*.svg
!/public/uploads/products/*.jpg

# Node modules & frontend dependencies
node_modules/
package-lock.json

# Vendor, logs & temporary runtime files
/vendor/
*.log
/tmp/

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

