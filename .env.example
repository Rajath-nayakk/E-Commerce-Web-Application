# ==============================================================================
# Database Configuration (MySQL / MariaDB or SQLite)
# Default for XAMPP / WAMP: driver=mysql, host=localhost, port=3306, user=root, pass=""
# Standalone zero-config: driver=sqlite, sqlite_path=database/store.sqlite
# ==============================================================================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_SQLITE_PATH=database/store.sqlite
DB_FALLBACK_SQLITE=true

# ==============================================================================
# Session & Security Settings
# ==============================================================================
SESSION_LIFETIME=7200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
UPLOAD_MAX_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/svg+xml

